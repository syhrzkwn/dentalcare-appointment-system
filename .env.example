# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is ignored by git, so your passwords are never committed.

# MySQL admin (root) password
MYSQL_ROOT_PASSWORD=

# Database user the app connects as
DB_USER=dentalcare
DB_PASSWORD=

# First admin account (admin panel login). Only used when the database is first created;
# after that, change the password from the admin Account page.
ADMIN_EMAIL=admin@dentalcare.com
ADMIN_PASSWORD=

# Ports on your machine (change if 3306 or 8080 is already in use)
DB_PORT=3306
APP_PORT=8080
